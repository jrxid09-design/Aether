# Salin ke .env lalu sesuaikan.

# ---- Daemon -----------------------------------------------------
PORT=3000
HOST=0.0.0.0
APP_NAME=Aether
APP_VERSION=0.1.0
NODE_ENV=development

# Token bidang kendali (/api/v1/console).
# WAJIB diisi bila daemon berjalan di PC rumah dan terjangkau LAN —
# tanpa ini, endpoint chat, eksekusi tool, dan filesystem terbuka
# tanpa autentikasi bagi siapa pun di jaringan yang sama.
# Isikan nilai yang sama di Aether Console -> Settings -> Token akses.
AETHER_TOKEN=

# ---- AI ----------------------------------------------------------
# ollama | openrouter
AI_PROVIDER=ollama

AETHER_OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ---- Memori jangka panjang ---------------------------------------
# Basis data memori terpisah dari data/aether.db.
# AETHER_MEMORY_DB=data/memory.db

# Model embedding untuk pencarian berbasis makna.
# Di PC rumah: ollama pull nomic-embed-text
# Tanpa ini memori tetap jalan, hanya pencariannya sebatas kata kunci.
AETHER_EMBED_MODEL=nomic-embed-text

# ---- Suara masuk (STT) -------------------------------------------
# Suara KELUAR (Aether bicara) sudah jalan tanpa konfigurasi lewat
# suara OS di Console. Suara MASUK butuh backend transcribe
# kompatibel-OpenAI (mis. faster-whisper-server / whisper.cpp server).
# Tanpa ini, mic dinonaktifkan dengan pesan jelas — mengetik tetap bisa.
# AETHER_STT_URL=http://localhost:8000/v1/audio/transcriptions
# AETHER_STT_MODEL=Systran/faster-whisper-base
# AETHER_STT_KEY=
#
# TTS neural (banyak suara + bahasa Indonesia). Endpoint /v1/audio/speech
# kompatibel-OpenAI, mis. Kokoro-FastAPI. Kosong → pakai suara OS.
# Efek "robot" diatur di layar Aether. Semua bisa diisi via Settings.
# AETHER_TTS_URL=http://localhost:8880/v1/audio/speech
# AETHER_TTS_MODEL=kokoro
# AETHER_TTS_VOICE=af_heart

# ---- Integrasi eksternal -----------------------------------------
# Menimpa nilai di configs/integrations.json.
# AETHER_OPENCLAW_URL=http://localhost:18789
# AETHER_HERMES_URL=http://localhost:8080
# AETHER_OPENCLAW_KEY=
# AETHER_HERMES_KEY=

# ---- Telegram ----------------------------------------------------
# Remote control Aether dari Telegram (long-polling, tanpa webhook).
# Token dari @BotFather. AETHER_TELEGRAM_ALLOWED = daftar chat id
# yang boleh mengendalikan Aether (pisahkan koma). Kirim /id ke bot
# untuk mengetahui chat id-mu. Tanpa allowlist, bot hanya membalas /id.
# AETHER_TELEGRAM_TOKEN=123456:ABC-DEF...
# AETHER_TELEGRAM_ALLOWED=123456789

# ---- Membuat tool sendiri ----------------------------------------
# Set ke 1 agar tool buatan Aether langsung aktif tanpa persetujuan.
# Default (kosong) lebih aman: tool baru jadi draft sampai disetujui.
# AETHER_TOOL_AUTOAPPROVE=

# ---- Lain-lain ----------------------------------------------------
MEMORY_PROVIDER=sqlite
AGENT_PROVIDER=aether
PLANNER_MODE=llm

# ---- Immich (galeri foto; dipakai skill pencari foto) -------------
# Kunci API dari Immich → Account Settings → API Keys.
IMMICH_API_KEY=GANTI_DENGAN_IMMICH_API_KEY
