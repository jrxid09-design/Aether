{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    ".opencode/plugins/graphify.js"
  ],
  "mcp": {
    "serena": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--project",
        "/mnt/c/Workspace/Aether",
        "--context",
        "desktop-app",
        "--transport",
        "stdio"
      ],
      "enabled": true,
      "timeout": 30000
    }
  }
}
